# ------------------------------------------------------------------
# Copy this file to .env and adjust. The real .env is gitignored.
#   cp .env.example .env
# Every value below has a working default, so the server runs with
# an empty .env — you only need to change things to turn features on.
# ------------------------------------------------------------------

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign JWTs. Change it to any long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# How verification codes are delivered:
#   console  - printed in this terminal, nothing sent    (default, zero setup)
#   ethereal - fake SMTP, gives a preview link, no real inbox
#   smtp     - a real mail server, fill in the SMTP_* values below
MAIL_MODE=console
MAIL_FROM="F1Paddock <no-reply@f1paddock.local>"

# Only needed when MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Which engine generates race predictions:
#   heuristic - points-and-form arithmetic, no key needed (default)
#   gemini | openai | anthropic - a real LLM, needs the matching key
AI_PROVIDER=heuristic

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
