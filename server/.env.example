# ------------------------------------------------------------------
# Copy this file to .env and adjust. The real .env is gitignored.
#   cp .env.example .env
# Every value below has a working default, so the server runs with
# an empty .env — you only need to change things to turn features on.
# ------------------------------------------------------------------

PORT=4000
NODE_ENV=development

# The one origin allowed to read this API's responses in a browser.
# Never '*' — a wildcard cannot be combined with cookies, and it would let
# any website read your users' data in their own browser.
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------
# Database. Either a local MongoDB...
MONGO_URI=mongodb://127.0.0.1:27017/f1paddock
# ...or a free MongoDB Atlas cluster, which needs no install:
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/f1paddock?retryWrites=true&w=majority
# ------------------------------------------------------------------

# Usernames that become stewards on sign-up, so the moderation queue can be
# reached while marking. A convenience for this project, not a real design:
# roles should be granted by an existing admin, never claimed at sign-up.
MODERATOR_USERNAMES=admin,moderator,steward

# Secret used to sign JWTs. Change it to any long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# How verification codes are delivered:
#   console  - printed in this terminal, nothing sent    (default, zero setup)
#   ethereal - fake SMTP, gives a preview link, no real inbox
#   smtp     - a real mail server, fill in the SMTP_* values below
MAIL_MODE=console
MAIL_FROM="F1Paddock <no-reply@f1paddock.local>"

# Only needed when MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Which engine generates race predictions:
#   heuristic - points-and-form arithmetic, no key needed (default)
#   gemini | openai | anthropic - a real LLM, needs the matching key
AI_PROVIDER=heuristic

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ------------------------------------------------------------------
# Local HTTPS (optional).
# Leave both blank and the server runs plain HTTP, which is correct for
# localhost and for production behind nginx — there, nginx holds the
# certificate and Node never sees a key.
#
# To try TLS on your own machine, make a self-signed pair:
#   openssl req -x509 -newkey rsa:2048 -nodes -days 365 \
#     -keyout server/certs/key.pem -out server/certs/cert.pem -subj "/CN=localhost"
# then point these at it. The browser will warn that the certificate is not
# from a trusted authority, which is correct — you signed it yourself.
# ------------------------------------------------------------------
SSL_KEY_PATH=
SSL_CERT_PATH=
